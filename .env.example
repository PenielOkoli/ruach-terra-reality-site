# Server-only SMTP credentials from the company's existing email provider.
# The recipient is fixed in code: info@ruachdredging.com.
# Missing/invalid configuration returns HTTP 503, never a fake success.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@ruachdredging.com
SMTP_PASSWORD=
SMTP_FROM=info@ruachdredging.com
# Optional legacy integration. Set to webhook only after confirming the receiver
# sends to info@ruachdredging.com. SMTP is the default; no duplicate delivery.
QUOTE_DELIVERY_MODE=smtp
QUOTE_WEBHOOK_URL=
QUOTE_WEBHOOK_SECRET=
# Optional Google Search Console HTML verification token (not a password).
GOOGLE_SITE_VERIFICATION=
